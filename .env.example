# ---------- Base de datos (Supabase) ----------
# Pooler de Supabase (Transaction mode, puerto 6543): lo usa la app.
DATABASE_URL="postgresql://postgres.XXXX:CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa (puerto 5432): solo para migraciones (prisma migrate).
DIRECT_URL="postgresql://postgres.XXXX:CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ---------- App ----------
# URL pública, sin "/" final. En local: http://localhost:3000
APP_URL="http://localhost:3000"
# Secreto largo y aleatorio (firma sesiones y enlaces). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
# Secreto que debe enviar el cron (header x-cron-secret). Otro valor aleatorio.
CRON_SECRET=""

# ---------- Correo ----------
# brevo | resend | consola (consola = muestra los correos en la terminal, para desarrollo)
MAIL_PROVIDER="consola"
MAIL_FROM_EMAIL="avisos@tu-dominio.cl"
MAIL_FROM_NAME="CR Juntos en la prueba"
BREVO_API_KEY=""
RESEND_API_KEY=""

# ---------- Web Push (VAPID) ----------
# Generar con: npm run generar-vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:avisos@tu-dominio.cl"
