// CR ora por ti — esquema de datos.
// Todas las fechas se guardan en UTC; se muestran en America/Santiago.
// Por diseño NO existe ningún campo para notas ni calificaciones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  JOVEN
  ORANTE
  LIDER
}

enum TipoEvaluacion {
  PRUEBA
  EXAMEN
  TRABAJO
  OTRO
}

enum EstadoEvaluacion {
  PENDIENTE
  REALIZADA
}

enum Animo {
  BIEN
  MAS_O_MENOS
  NECESITA_ORACION
}

// 1H | 3H | noche anterior a las 20:00 (hora de Chile)
enum Anticipacion {
  UNA_HORA
  TRES_HORAS
  NOCHE_ANTERIOR_20H
}


enum TipoAviso {
  ANTES
  DESPUES
}

enum Canal {
  EMAIL
  PUSH
}

enum EstadoEnvio {
  ENVIANDO
  OK
  FALLO
}

// Orantes y líder entran con correo. Los jóvenes NO inician sesión: se identifican
// con nombre, apellido y teléfono, y su celular queda recordado (DeviceToken).
model User {
  id             String   @id @default(cuid())
  email          String?  @unique
  nombre         String
  apellido       String?
  // Formato +569XXXXXXXX. Solo lo ve la líder.
  telefono       String?  @unique
  rol            Rol      @default(ORANTE)
  createdAt      DateTime @default(now())
  // Consentimiento al registrarse
  aceptoAvisoAt  DateTime?
  // Se incrementa para invalidar todas las sesiones del usuario
  sessionVersion Int      @default(0)
  // Orantes nuevos quedan pendientes (null) hasta que alguien con rol líder los aprueba:
  // mientras tanto no ven la agenda ni reciben avisos.
  aprobadoAt     DateTime?
  // Contraseña cifrada con scrypt (solo orantes y líderes; los jóvenes no tienen)
  passwordHash   String?

  evaluaciones     Evaluation[]
  prefs            NotificationPrefs?
  pushSubs         PushSubscription[]
  oraciones        PrayerLog[]
  avisos           NotificationLog[]
  codigosCreados   InviteCode[]
  dispositivos     DeviceToken[]
  enlacesAcceso    EnlaceAcceso[]
}

// Recuerda al joven en su celular (cookie httpOnly de larga duración). Solo se guarda el hash.
model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Evaluation {
  id              String           @id @default(cuid())
  userId          String
  tipo            TipoEvaluacion
  ramo            String
  fechaHora       DateTime
  estado          EstadoEvaluacion @default(PENDIENTE)
  resultadoAnimo  Animo?
  createdAt       DateTime         @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  oraciones PrayerLog[]
  avisos    NotificationLog[]

  @@index([fechaHora])
  @@index([userId])
}

model NotificationPrefs {
  userId          String       @id
  emailAntes      Boolean      @default(false)
  emailDespues    Boolean      @default(false)
  pushAntes       Boolean      @default(true)
  pushDespues     Boolean      @default(true)
  tambienCorreo   Boolean      @default(false)
  anticipacion    Anticipacion @default(UNA_HORA)
  // Lo marca el chequeo diario cuando el push de este usuario no responde bien
  pushNecesitaReactivar Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id             String    @id @default(cuid())
  userId         String
  endpoint       String    @unique
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastSuccessAt  DateTime?
  lastErrorAt    DateTime?
  activa         Boolean   @default(true)
  fallosSeguidos Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PrayerLog {
  id           String   @id @default(cuid())
  evaluationId String
  userId       String
  createdAt    DateTime @default(now())

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, userId])
}

model NotificationLog {
  id           String      @id @default(cuid())
  userId       String
  evaluationId String
  tipo         TipoAviso
  canal        Canal
  estado       EstadoEnvio @default(ENVIANDO)
  sentAt       DateTime    @default(now())
  // Reintentos del correo si el proveedor falla (el push fallido no se reintenta: pasa a correo)
  intentos     Int         @default(1)
  error        String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  // Garantiza que NUNCA se envíe dos veces el mismo aviso por el mismo canal
  @@unique([userId, evaluationId, tipo, canal])
}

model InviteCode {
  id          String   @id @default(cuid())
  code        String   @unique
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdById String?

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Enlace de un solo uso para crear o cambiar la contraseña (lo envía quien tiene rol líder,
// o lo entrega el script crear-lider). Solo se guarda el hash.
model EnlaceAcceso {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Rate limiting compartido entre instancias serverless
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}
